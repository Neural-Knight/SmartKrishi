# SmartKrishi Go Backend — Environment Configuration
# Copy to .env and fill in values.

# Server
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://smartkrishi_user:smartkrishi_password@localhost:5432/smartkrishi_db

# Security / JWT
SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:5173

# Firebase (mobile auth)
FIREBASE_CREDENTIALS=/path/to/serviceAccountKey.json

# AI
GEMINI_API_KEY=your-google-gemini-api-key
# GOOGLE_API_KEY=alternative-to-GEMINI_API_KEY

# External tool APIs (agent pipeline)
WEATHERAPI_KEY=
DATA_GOV_KEY=
AGMARKNET_ID=

# SMS / Telegram fallback (Milestone 3+)
SMS_API_BASE_URL=
TELEGRAM_SERVICE_URL=
