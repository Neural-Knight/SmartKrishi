# SmartKrishi Go Backend — Environment Configuration
# Copy to .env and fill in values.

# Server
PORT=8000
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://smartkrishi_user:smartkrishi_password@127.0.0.1:5432/smartkrishi_db?sslmode=disable

# Security / JWT
SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:5173

# Firebase (mobile auth — Step 4)
# Provide the service-account credentials in ONE of two ways (matches Python firebase_service.py):
#   Option A (local dev): absolute path to the downloaded service-account key file.
#   Option B (prod/Render): the full JSON content of the key, inline on one line.
# The backend detects which: a value starting with '{' is treated as inline JSON, otherwise as a file path.
FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"smartkrishi-83352", ... }

# Firebase project ID (Python hard-coded this as smartkrishi-83352; must match the key's project_id).
FIREBASE_PROJECT_ID=smartkrishi-83352

# AI
GEMINI_API_KEY=your-google-gemini-api-key
# GOOGLE_API_KEY=alternative-to-GEMINI_API_KEY

# Agent pipeline models (Step 6) — per-role Gemini model names; defaults match config.go
AGENT_PLANNER_MODEL=gemini-2.5-flash
# AGENT_MODEL: main agent (streaming). Python used gemini-2.5-pro for /ask; default here is flash.
AGENT_MODEL=gemini-2.5-flash
AGENT_CHECKER_MODEL=gemini-2.5-flash

# External tool APIs (agent pipeline)
WEATHERAPI_KEY=
DATA_GOV_KEY=
AGMARKNET_ID=

# File uploads — local disk dir for uploaded file bytes; files are also
# uploaded to the Gemini File API. Default: uploads
UPLOADS_DIR=uploads

# SMS / Telegram fallback (Milestone 3+)
SMS_API_BASE_URL=
TELEGRAM_SERVICE_URL=
